    {
      "id": "nao-apenas",
      "regex": "(?i)\\bn[aã]o [eé] (?:apenas|s[oó]|somente) [^.!?\\n]{2,60}[,.;]\\s*[eé]\\b",
      "name": "\"Não é apenas X, é Y\"",
      "fix": "Diga a única coisa que você quer dizer. Apague a metade da preparação."
    },
    {
      "id": "nao-so",
      "regex": "(?i)\\bn[aã]o (?:s[oó]|apenas|somente)\\b[^.!?\\n]{2,80}\\b(?:mas tamb[eé]m|como tamb[eé]m)\\b",
      "name": "\"Não só X, mas também Y\"",
      "fix": "Divida em duas frases, ou corte a metade mais fraca."
    },
    {
      "id": "nao-e-sobre",
      "regex": "(?i)\\b(?:isso|n[aã]o) (?:n[aã]o )?[eé] sobre [^.!?\\n]{2,60}[.!;,]\\s*[eé] sobre\\b",
      "name": "\"Não é sobre X. É sobre Y.\"",
      "fix": "Comece pelo Y. A inversão é o que entrega."
    },
    {
      "id": "o-resultado",
      "regex": "(?i)^\\s*(?:o resultado|a melhor parte|o detalhe|o problema|o segredo|e sabe o que mais)\\?\\s*$",
      "name": "Linha só com pergunta retórica",
      "fix": "Responda na mesma frase em vez de encenar uma revelação."
    },
    {
      "id": "aprendi",
      "regex": "(?i)\\b(?:aqui est[aá]|olha|veja) o que (?:eu|n[oó]s|a gente) aprend(?:i|emos|eu)\\b",
      "name": "\"Aqui está o que eu aprendi\"",
      "fix": "Diga a lição. Pule o anúncio."
    },
    {
      "id": "trio",
      "regex": "(?i)\\b[\\wà-ÿ]+, [\\wà-ÿ]+ e [\\wà-ÿ]+\\.",
      "name": "Trio de três itens",
      "fix": "Dois itens ou quatro. Três é o ritmo padrão da máquina."
    },
    {
      "id": "foguete",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1✨\\U0001F3AF]",
      "name": "Emoji de foguete / fogo / lâmpada / brilho / alvo",
      "fix": "No máximo um emoji, e não um desses cinco."
    },
    {
      "id": "muro-hashtag",
      "regex": "(?:#\\w+[ \\t]*){6,}",
      "name": "Muro de hashtags (6+)",
      "fix": "No máximo cinco, que é o limite do Instagram. Três específicas costumam bastar."
    },
    {
      "id": "como-ia",
      "regex": "(?i)\\bcomo (?:uma )?(?:ia|intelig[eê]ncia artificial)\\b|\\bcomo um modelo de linguagem\\b",
      "name": "Referência ao próprio modelo",
      "fix": "Apague a frase."
    },
    {
      "id": "conclusao",
      "regex": "(?i)^\\s*(?:em resumo|resumindo|em suma|em conclus[aã]o|concluindo|para finalizar)\\b",
      "name": "Abertura de conclusão de redação",
      "fix": "Post não precisa de parágrafo de conclusão."
    },
    {
      "id": "isca-engajamento",
      "regex": "(?i)(?:concorda\\?|o que voc[eê] acha\\?|quem mais\\b[^\\n]*\\?|t[oô] errad[oa]\\?|e voc[eê]\\?)\\s*$",
      "name": "Isca de engajamento automática",
      "fix": "Faça uma pergunta que só você faria, sobre a coisa específica acima."
    },
    {
      "id": "pare-de-rolar",
      "regex": "(?im)^\\s*(?:pare de rolar|para de rolar|n[aã]o (?:role|rola|passa|pule)|espera,? n[aã]o (?:passa|rola))\\b",
      "name": "Abertura \"pare de rolar\"",
      "fix": "O que faz parar de rolar tem que ser a própria afirmação. Pedir atenção mostra que você ainda não a conquistou."
    },
    {
      "id": "neste-video",
      "regex": "(?i)\\b(?:n(?:est|ess)e (?:v[ií]deo|reel|post)|no (?:v[ií]deo|reel|post) de hoje|hoje (?:eu )?vou (?:te )?(?:mostrar|ensinar)|vou (?:te )?(?:mostrar|ensinar) como)\\b",
      "name": "Enrolação de vídeo (\"neste vídeo eu vou te mostrar\")",
      "fix": "Apague e comece direto no resultado. Os dois primeiros segundos decidem o reel inteiro."
    },
    {
      "id": "emoji-lista",
      "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF✅➡⬅✔✨👉]\\s*\\S",
      "name": "Lista com emoji como marcador",
      "fix": "Use hífen ou quebra de linha. Lista com emoji é a coisa com mais cara de modelo numa legenda."
    },
    {
      "id": "caixa-alta",
      "regex": "\\b[A-ZÀ-Ö]{3,}\\b(?:\\s+\\b[A-ZÀ-Ö]{3,}\\b){2,}",
      "name": "Três ou mais palavras gritadas seguidas",
      "fix": "Caixa alta é botão de volume, não marca-texto. Uma palavra, no máximo."
    },
