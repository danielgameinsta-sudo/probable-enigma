      "id": "isca-seguir",
      "regex": "(?i)\\b(?:me segue para mais|siga para mais|segue pra mais|marque (?:algu[eé]m|um amigo|uma amiga) que|curta se|compartilhe se|comente (?:aqui )?se)\\b",
      "name": "Isca automática de seguir ou marcar",
